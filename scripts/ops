#!/usr/bin/env bash
# The agent's and the operator's way to the tester stream: logs, diagnostics,
# errors, tickets, CI and release state. See cmd/ops.
#
#   scripts/ops testers
#   scripts/ops logs tester-001 --last 1h
#   scripts/ops diag tester-001
#   scripts/ops mcp          (stdio MCP server, hikkari-ops)
set -euo pipefail
# An MCP client may start this without the login shell's PATH.
export PATH="$PATH:/usr/local/go/bin:/opt/homebrew/bin:$HOME/go/bin"
cd "$(dirname "$0")/.."
exec go run ./cmd/ops "$@"
