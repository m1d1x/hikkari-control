# Installed by the nekko hub: the cascade's trunk entry.
[Unit]
Description=Nekko trunk entry
After=network-online.target
Wants=network-online.target

[Service]
# Generations (trunkentry/handoff.go): the process says when it is up, a
# newer one takes over as the main process, and a reload hands over to the
# binary on disk without cutting what the entry carries. Timeouts cover a
# child's 30 s to come up and the old generations' quick end on a stop.
Type=notify
NotifyAccess=all
EnvironmentFile=/etc/nekko-trunk-entry.env
ExecStart=/usr/local/lib/nekko-trunk-entry/nekko-trunk-entry run
ExecReload=+/usr/local/lib/nekko-trunk-entry/nekko-trunk-entry reload
RuntimeDirectory=nekko-trunk-entry
TimeoutStartSec=90
TimeoutStopSec=30
Restart=always
RestartSec=2
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
