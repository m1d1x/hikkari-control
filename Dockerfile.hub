# syntax=docker/dockerfile:1.7
# The fleet hub (cmd/hub), carrying what it deploys to the boxes it runs:
# linux-<arch>/{nekko-edge,nekko-entry-prober,nekko-trunk-entry,nekko-cascade-probe,libcronet.so,hikkari-wire-stand-h3,hk-pipe}
# under the artifact directory
# (internal/entry DefaultArtifactDir). The image is the version: a box runs the
# current build when its binary's digest equals the one in here.

# ── Hub and prober ───────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/hub ./cmd/hub
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    for arch in amd64 arm64; do \
      CGO_ENABLED=0 GOOS=linux GOARCH=$arch go build -trimpath -ldflags="-s -w" \
        -o /out/relay/linux-$arch/nekko-entry-prober ./cmd/entry-prober || exit 1; \
      CGO_ENABLED=0 GOOS=linux GOARCH=$arch go build -trimpath -ldflags="-s -w" \
        -o /out/relay/linux-$arch/nekko-cascade-probe ./cmd/cascade-probe || exit 1; \
    done

# ── The VPN exit (edge/, its own module on the Go its Xray needs) ───────────
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS edge-builder
WORKDIR /src/edge
COPY edge/go.mod edge/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY edge/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    for arch in amd64 arm64; do \
      CGO_ENABLED=0 GOOS=linux GOARCH=$arch go build -trimpath -ldflags="-s -w" \
        -o /out/relay/linux-$arch/nekko-edge . || exit 1; \
    done

# ── The cascade's trunk entry (trunkentry/, its own module: it links cronet) ─
# Pure Go with purego: the binary loads libcronet.so from its own directory,
# which the hub stages beside it (internal/entry/trunk.go). Built on Debian,
# not Alpine: Go's linker names the build host's loader, and on Alpine that is
# musl's, which the boxes (glibc, like libcronet.so itself) do not have.
FROM --platform=$BUILDPLATFORM golang:1.27-bookworm AS trunk-builder
WORKDIR /src/trunkentry
COPY trunkentry/go.mod trunkentry/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY trunkentry/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    for arch in amd64 arm64; do \
      mkdir -p /out/relay/linux-$arch && \
      CGO_ENABLED=0 GOOS=linux GOARCH=$arch go build -tags with_purego -trimpath -ldflags="-s -w" \
        -o /out/relay/linux-$arch/nekko-trunk-entry . && \
      cp "$(go list -m -f '{{.Dir}}' github.com/sagernet/cronet-go/lib/linux_$arch)/libcronet.so" \
        /out/relay/linux-$arch/libcronet.so || exit 1; \
    done
# The Rust pipe's source (rust/ of hikkari-protocol) at the version the
# entry's brain speaks to: the root module of the same commit as its
# trunk/pipectl, so the brain and the pipe share one socket version.
RUN --mount=type=cache,target=/go/pkg/mod \
    v=$(go list -m -f '{{.Version}}' github.com/m1d1x/hikkari-protocol) && \
    dir=$(go mod download -json github.com/m1d1x/hikkari-protocol@$v | sed -n 's/^\t"Dir": "\(.*\)",$/\1/p') && \
    test -f "$dir/rust/Cargo.lock" && mkdir -p /out/protocol && cp -r "$dir/rust" /out/protocol/rust && \
    chmod -R u+w /out/protocol

# ── The entry's pipe in Rust (hk-pipe, roadmap 4.6) ──────────────────────────
# For glibc, not musl: it loads libcronet.so (a glibc library) for the pool's
# members. Cross-built from the build platform for both boxes' architectures;
# it needs glibc 2.34 or later on the box (the stand's swap runs it first).
FROM --platform=$BUILDPLATFORM rust:1.97.1-bookworm AS pipe-builder
RUN host=$(dpkg --print-architecture) && pkgs="" && \
    { [ "$host" = amd64 ] || pkgs="$pkgs gcc-x86-64-linux-gnu libc6-dev-amd64-cross"; } && \
    { [ "$host" = arm64 ] || pkgs="$pkgs gcc-aarch64-linux-gnu libc6-dev-arm64-cross"; } && \
    apt-get update && apt-get install -y --no-install-recommends $pkgs && rm -rf /var/lib/apt/lists/* && \
    rustup target add x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu
COPY --from=trunk-builder /out/protocol/rust /src/rust
WORKDIR /src/rust
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    for pair in amd64:x86_64 arm64:aarch64; do \
      arch=${pair%%:*}; target=${pair#*:}-unknown-linux-gnu; \
      cargo build --release --locked -p hikkari-pipe --target $target && \
      mkdir -p /out/relay/linux-$arch && cp target/$target/release/hk-pipe /out/relay/linux-$arch/hk-pipe || exit 1; \
    done

# ── The stand's entry with Chromium's QUIC (edge/, -tags wirestand_h3) ──────
# The wire stand's entry (internal/entry/wirestand.go) runs the edge built
# with cronet, for its wire h3; the relays' edge above has none. Pure Go with
# purego, on Debian for the same reason as the trunk entry; the hub stages the
# trunk entry's libcronet.so beside it.
FROM --platform=$BUILDPLATFORM golang:1.27-bookworm AS stand-builder
WORKDIR /src/edge
COPY edge/go.mod edge/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY edge/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    for arch in amd64 arm64; do \
      mkdir -p /out/relay/linux-$arch && \
      CGO_ENABLED=0 GOOS=linux GOARCH=$arch go build -tags with_purego,wirestand_h3 -trimpath -ldflags="-s -w" \
        -o /out/relay/linux-$arch/hikkari-wire-stand-h3 . || exit 1; \
    done

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 1000 hub
COPY --from=builder /out/hub /usr/local/bin/hub
COPY --from=builder /out/relay/ /usr/local/share/nekko/relay/
COPY --from=edge-builder /out/relay/ /usr/local/share/nekko/relay/
COPY --from=trunk-builder /out/relay/ /usr/local/share/nekko/relay/
COPY --from=stand-builder /out/relay/ /usr/local/share/nekko/relay/
COPY --from=pipe-builder /out/relay/ /usr/local/share/nekko/relay/
RUN mkdir -p /data && chown hub:hub /data
USER hub
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/hub"]
