		"happy-dom": "^21.0.4",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.2.1",
		"typescript": "^5.9.3",
		"vite": "^6.4.1"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/inter": "^5.2.8",
		"echarts": "^5.6.0"
	}
