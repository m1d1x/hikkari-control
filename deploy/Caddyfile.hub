{
    # Runtime reverse-proxy errors can include request addresses too.
    log default {
        output discard
    }
}

{$DOMAIN:localhost} {
    # A bench uploads a photo-sized 1 MiB. Its route holds its own cap, behind a
    # vantage's token (internal/entry/bench_api.go, maxBenchBlob).
    @bench path /api/v1/internal/entry-bench/*
    request_body @bench {
        max_size 8MiB
    }
    @notBench not path /api/v1/internal/entry-bench/*
    request_body @notBench {
        max_size 1MB
    }
    reverse_proxy hub:8090 {
        header_up -X-Forwarded-For
        header_up -X-Real-IP
    }
}

:8444 {
    request_body {
        max_size 1MB
    }
    @clientSupport path /api/v1/support/report /api/v1/support/tester-logs
    handle @clientSupport {
        reverse_proxy hub:8090 {
            header_up -X-Forwarded-For
            header_up -X-Real-IP
        }
    }
    handle /api/* {
        reverse_proxy hub:3310 {
            header_up -X-Forwarded-For
            header_up -X-Real-IP
        }
    }
    handle {
        reverse_proxy admin:80
    }
}
