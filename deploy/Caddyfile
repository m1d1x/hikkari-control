# Access logs stay off: Caddy writes none unless a site has a `log`
# directive, and none does. Runtime logs are kept at WARN so no request
# details (client IPs) reach them.
{
	log default {
		output stderr
		level WARN
	}
}

{$DOMAIN} {
	request_body {
		max_size 64KB
	}
	reverse_proxy downdetector:8080 {
		# The service never needs the client address.
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}
